PORT=

MONGODB_URI=mongodb://localhost:27018/autominutes
# Port 27018 (not the Mongo default 27017) - see docker-compose.yml. Avoids a real
# ambiguity on Windows if a native MongoDB service is also installed and listening
# on 127.0.0.1:27017: Docker's published port can end up reachable only over IPv6,
# so "localhost:27017" silently resolves to whichever server the OS picks first,
# and tools like Compass can land on a different Mongo instance than the app does.

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
FRONTEND_URL=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Cloudflare R2 (avatar storage). Bucket must allow public read.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL for the bucket (r2.dev dev URL or a custom domain), no trailing slash
R2_PUBLIC_URL=

# Mail / SMTP (email verification codes). Gmail: host=smtp.gmail.com, port=587, secure=false.
# MAIL_PASSWORD is a 16-char Google App Password (requires 2FA on the account), spaces stripped.
# MAIL_FROM must be the authenticated address or a verified "Send mail as" alias.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="AutoMinutes <youraccount@gmail.com>"